# Buildroot 2015.08.1 is the release that still supports upstream uClibc
# 0.9.33.2. Its GCC 4.9.x selection resolves to GCC 4.9.3.
#
# The device kernel is 3.4.110; use the latest 3.4 headers available here.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y

BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_UCLIBC=y
BR2_UCLIBC_VERSION_0_9_33=y
BR2_GCC_VERSION_4_9_X=y
BR2_KERNEL_HEADERS_3_4=y
BR2_SHARED_LIBS=y
